@@ -0,0 +1,43 @@
+import Foundation
+
+/// What `StikJIT.removeDDIs` took off a device.
+public struct DDIRemoval: Sendable {
+
+    /// The version of the DDI cryptex that was uninstalled, or nil if none was
+    /// installed.
+    public var cryptexVersion: String?
+
+    /// Where the image mounter had images mounted that have been unmounted.
+    public var unmountedPaths: [String] = []
+
+    /// What couldn't be removed, one message per step that failed.
+    ///
+    /// Every step is attempted regardless, so a removal with failures may
+    /// still have removed something; the two properties above say what.
+    public var failures: [String] = []
+
+    /// Whether anything was removed.
+    public var removedAnything: Bool {
+        cryptexVersion != nil || !unmountedPaths.isEmpty
+    }
+}
+
+extension StikJIT {
+
+    /// Removes every developer disk image from the device.
+    ///
+    /// For testing preparation from scratch. A device that has ever had the DDI
+    /// cryptex installed -- by Xcode, or by `mountDDI` -- grafts it again at
+    /// every boot, so rebooting doesn't get back to a device that needs one.
+    ///
+    /// Throws only if the device can't be reached at all. Anything that fails
+    /// past that is reported in the result's `failures` instead.
+    ///
+    /// Leaves the downloaded files alone; `resetCachedDDI(at:)` is for those.
+    public static func removeDDIs(
+        pairingFile: URL,
+        configuration: Configuration = .default
+    ) throws -> DDIRemoval {
+        try DDISession(pairingFilePath: pairingFile.path, configuration: configuration).removeAll()
+    }
+}
