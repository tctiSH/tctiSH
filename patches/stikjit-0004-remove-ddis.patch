+    /// Takes every developer disk image off the device.
+    ///
+    /// Both kinds: the DDI cryptex, which stays installed and is grafted again
+    /// at every boot, and whatever the image mounter has mounted, which lasts
+    /// until the next reboot. The cryptex goes first, as its graft may be what
+    /// the image mounter is reporting.
+    ///
+    /// Only a tunnel that can't be made throws. Past that, every step is tried
+    /// whatever became of the ones before it, and what failed is collected in
+    /// `failures`: stopping at the first would hide what had already gone.
+    func removeAll() throws -> DDIRemoval {
+        let tunnel = try makeTunnel()
+        defer { tunnel.free() }
+
+        var removal = DDIRemoval()
+
+        do {
+            removal.cryptexVersion = try uninstallCryptex(over: tunnel)
+        } catch {
+            removal.failures.append("uninstalling the DDI cryptex: \(error.localizedDescription)")
+        }
+
+        do {
+            try unmountImages(over: tunnel, into: &removal)
+        } catch {
+            removal.failures.append("querying the image mounter: \(error.localizedDescription)")
+        }
+
+        return removal
+    }
+
+    /// Uninstalls the DDI cryptex, returning the version that was installed, or
+    /// nil if there wasn't one.
+    private func uninstallCryptex(over tunnel: Tunnel) throws -> String? {
+        var installed: UnsafeMutablePointer<InstalledCryptexC>?
+        try IdeviceFFI.check("failed to query installed DDI cryptex") {
+            cryptexd_installed_ddi(tunnel.adapter, tunnel.handshake, &installed)
+        }
+
+        guard let installed else { return nil }
+        defer { cryptexd_free_installed_cryptex(installed) }
+        let identifier = String(cString: installed.pointee.identifier)
+
+        var client: OpaquePointer?
+        try IdeviceFFI.check("failed to connect to cryptexd") {
+            cryptexd_connect_rsd(tunnel.adapter, tunnel.handshake, &client)
+        }
+        guard let client else { throw StikJITError.debugProxyUnavailable }
+
+        // A nil version uninstalls all of them, not just the one reported; one left behind would
+        // be grafted again at the next boot. Consumes the client.
+        try IdeviceFFI.check("failed to uninstall DDI cryptex") {
+            identifier.withCString { cryptexd_uninstall(client, $0, nil) }
+        }
+
+        return installed.pointee.version.map { String(cString: $0) } ?? "unknown"
+    }
+
+    /// Unmounts whatever the image mounter reports.
+    ///
+    /// Carries on past a path that won't unmount, recording it in `failures`,
+    /// so that one refusal doesn't leave the rest mounted. Only connecting and
+    /// listing throw.
+    private func unmountImages(over tunnel: Tunnel, into removal: inout DDIRemoval) throws {
+        var client: OpaquePointer?
+        try IdeviceFFI.check("failed to connect to image mounter") {
+            image_mounter_connect_rsd(tunnel.adapter, tunnel.handshake, &client)
+        }
+        guard let client else { throw StikJITError.debugProxyUnavailable }
+        defer { image_mounter_free(client) }
+
+        var devices: UnsafeMutablePointer<plist_t?>?
+        var deviceCount = 0
+        try IdeviceFFI.check("failed to fetch mounted devices") {
+            image_mounter_copy_devices(client, &devices, &deviceCount)
+        }
+
+        // Read out before anything is unmounted, so the list is freed however that goes.
+        var mountPaths: [String] = []
+        if let devices {
+            for index in 0..<deviceCount {
+                if let path = plist_dict_get_item(devices[index], "MountPath"),
+                   let string = plist_get_string_ptr(path, nil) {
+                    mountPaths.append(String(cString: string))
+                }
+                plist_free(devices[index])
+            }
+            idevice_data_free(
+                UnsafeMutableRawPointer(devices).assumingMemoryBound(to: UInt8.self),
+                UInt(deviceCount * MemoryLayout<plist_t?>.stride))
+        }
+
+        // `isMounted` counts any entry at all as mounted, so one without a path still has to go,
+        // or this would leave the device looking exactly as it found it. `/System/Developer` is
+        // where a DDI mounts.
+        if deviceCount > 0 && mountPaths.isEmpty {
+            mountPaths = ["/System/Developer"]
+        }
+
+        for path in mountPaths {
+            do {
+                try IdeviceFFI.check("failed to unmount \(path)") {
+                    path.withCString { image_mounter_unmount_image(client, $0) }
+                }
+                removal.unmountedPaths.append(path)
+            } catch {
+                removal.failures.append("unmounting \(path): \(error.localizedDescription)")
+            }
+        }
+    }
+
