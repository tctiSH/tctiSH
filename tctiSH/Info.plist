<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.ara.tctish.pairing</string>
	</array>
	<!-- Terminal themes, which open in Settings from Files or AirDrop. See SceneDelegate. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>tctiSH Terminal Theme</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.ara.tctiSH.terminal-theme</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
		<!-- Exists only to raise the Local Network prompt deliberately. See LocalNetworkPermission.swift. -->
		<string>_tctishprobe._tcp</string>
	</array>
	<!-- tctiSH's UIApplication, which sees every key whatever has the keyboard. See TctiApplication.swift. -->
	<key>NSPrincipalClass</key>
	<string>TctiApplication</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>tctiSH advertises itself on your local network so this device can pair with it, which is what lets the VM run with JIT.</string>
	<!-- A TTY moving to a new window, by menu or by dragging its card out. See WindowScenes. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>io.ara.tctish.tty</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>hare.fill</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>This session only</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Run with JIT</string>
			<key>UIApplicationShortcutItemType</key>
			<string>io.ara.tctish.shortcut.with-jit</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>tortoise.fill</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>This session only</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Run without JIT</string>
			<key>UIApplicationShortcutItemType</key>
			<string>io.ara.tctish.shortcut.without-jit</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>lifepreserver</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Start Linux from scratch</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Recovery Boot</string>
			<key>UIApplicationShortcutItemType</key>
			<string>io.ara.tctish.shortcut.recovery</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>gearshape.fill</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Boot waits for close</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Open Settings</string>
			<key>UIApplicationShortcutItemType</key>
			<string>io.ara.tctish.shortcut.settings-first</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A terminal theme, shared and imported from Settings > Appearance. See TerminalTheme.swift.
	     Data rather than text, though it's JSON with comments: Quick Look shows text files itself,
	     and would show this as its JSON rather than through the ThemeThumbnail and ThemeQuickLook
	     extensions. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.ara.tctiSH.terminal-theme</string>
			<key>UTTypeDescription</key>
			<string>tctiSH Terminal Theme</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tctheme</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
