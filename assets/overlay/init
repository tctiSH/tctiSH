#!/bin/sh

make_misc_dev() {
	TARGET=$1
	NAME=$2

	# Find the minor number for our device node...
	MAJOR=10
	MINOR=$(cat /proc/misc | grep $NAME | cut -d " "  -f 1)

	# ... and create our node file.
	mknod $TARGET c $MAJOR $MINOR
}


# Set up our basic device environment.
mount -t devtmpfs  none /dev
mkdir -p /dev/pts
mount -t devpts    none /dev/pts
mount -t proc	   none /proc
mount -t sysfs	   none /sys

# Set up networking.
ifconfig eth0 192.168.100.100
ip route add default via 192.168.100.2 dev eth0

# Create the mount points for our final union filesystem...
mkdir -p /var/tcti-rootfs/ro-root
mkdir -p /var/tcti-rootfs/rw-ios
mkdir -p /var/tcti-rootfs/rw-union

# Prepare root to be used as aprt of our unionfs.
mount --bind / /var/tcti-rootfs/ro-root

# Create our connection to our real filesystem contianer.
if grep "tcti_disk=file" /proc/cmdline; then
	# If we're using a file backend (e.g. for development), mount it.
	#
	# /dev/vda comes from devtmpfs, mounted above. This used to be a hand-rolled
	# `mknod /dev/ios0 b 254 0`, which worked only because virtio-blk happened to
	# land on major 254 -- the major is allocated dynamically at registration, so
	# nothing guarantees it, and the failure mode is a device node pointing at
	# nothing.
	#
	# The mkfs path should never run: empty.qcow ships with a made ext4 on it, so
	# that a first launch does not pay for formatting 200 GiB under emulation.
	# What follows is a safety net, and it is written to be safe in the direction
	# that matters -- it will decline to format far more readily than it will
	# destroy something.
	#
	# It used to test `[ $MOUNTSTAT == 255 ]`, which is not a status mount
	# returns: busybox gives 1 on failure and util-linux gives 32. So the branch
	# was dead, and a failed mount fell through silently -- the overlay's upper
	# layer would end up on the initramfs tmpfs, the guest would look entirely
	# normal, and every write would vanish at the next boot.
	#
	# The obvious repair, `-ne 0`, is worse than the bug: mount also fails for a
	# dirty filesystem, for a feature this kernel does not implement, and for a
	# transient device error. Formatting in response to any of those destroys the
	# user's data to fix a problem they did not have.
	#
	# So the question asked is not "did the mount fail" but "is there anything
	# there at all", which is what blkid answers.
	#
	# Its *output* is tested rather than its exit status, and that is not
	# fussiness: blkid here is the busybox applet, which exits 0 whether or not it
	# recognises anything. Checking the status instead makes every disk look
	# occupied -- which fails safe, but turns a genuinely blank disk into a guest
	# that silently never persists anything. Found by testing it.
	#
	# -o discard so that space the guest frees goes back to the phone as it is
	# freed. Without it ext4 never reports a deleted block, and disk.qcow only
	# ever grows: virtio-blk would carry the discard, and QEMU would punch the
	# hole in the file (qemu_launcher.c opens the drive with discard=unmap), but
	# nothing ever asks. It costs a discard per freed extent at commit, which a
	# mass delete pays for in one go. A device that cannot discard only earns a
	# warning from ext4, never a failed mount.
	if ! mount -o discard /dev/vda /var/tcti-rootfs/rw-ios; then
		if [ -n "$(blkid /dev/vda 2>/dev/null)" ]; then
			echo "--------------------------------------------------------------------------"
			echo "The persistent disk has a filesystem, but it could not be mounted."
			echo ""
			echo "Refusing to reformat it: the data is probably still there, and this"
			echo "may just need an fsck. Changes made in this session will NOT persist."
			echo "--------------------------------------------------------------------------"
		else
			echo "--------------------------------------------------------------------------"
			echo "The persistent disk holds no filesystem. Creating one."
			echo "--------------------------------------------------------------------------"

			mkfs.ext4 /dev/vda

			if mount -o discard /dev/vda /var/tcti-rootfs/rw-ios; then
				echo "Persistent disk created and mounted."
			else
				echo "----------------------------------------------------------------------"
				echo "The disk was formatted but still will not mount. Changes made in this"
				echo "session will NOT persist."
				echo "----------------------------------------------------------------------"
			fi
		fi
	fi

	# Trim once per cold boot, in the background:
	#
	#   - Everything a disk freed before it was mounted with -o discard.
	#   - Partial clusters. QEMU only frees a qcow2 cluster (64 KiB) when the
	#     whole of it is discarded, so a 4 KiB delete inside a live cluster is
	#     dropped, and online discard never revisits it once its neighbors go too.
	#     fstrim walks free extents, so it sends them whole.
	#
	# From here because the mount is outside the chroot: it is not in the
	# guest's mount table, so nothing inside would ever think to trim it.
	# Resuming a saved session skips this script, but a resumed guest has
	# already mounted with discard: this script is in initrd.img, which the
	# snapshot epoch digests, so no session saved under an older init resumes.
	#
	# Backgrounded and niced, since it walks every block group under emulation
	# and the boot should not wait for that. It survives the exec below as a child
	# of PID 1, which busybox init reaps. Its report goes to the kernel log, so
	# `dmesg` shows what it reclaimed and when it finished.
	#
	# /sbin/fstrim by path because nice does the lookup, not the shell: the
	# kernel starts init with no PATH, and nice's execvp then falls back to
	# libc's default of /bin:/usr/bin, which misses /sbin. The shell has a
	# default that includes it, which is why nothing else here
	# needs a path.
	if mountpoint -q /var/tcti-rootfs/rw-ios; then
		nice -n 19 /sbin/fstrim -v /var/tcti-rootfs/rw-ios >/dev/kmsg 2>&1 &
	fi

else
	echo "--------------DISK BACKEND NOT YET IMPLEMENTED!--------------"
	echo ""
	echo "Dropping you into an environment where changes will not persist."
	echo ""
	echo "-------------------------------------------------------------"
fi

# Create a home directory for root.
mkdir -p /var/tcti-rootfs/rw-ios/userroot/root
chmod 700 /var/tcti-rootfs/rw-ios/userroot/root

# Disks from before the terminal moved from SSH to the virtio console.
#
# The disk is the overlay's upper layer, so a copy of a file on it hides the
# image's. Checked on every boot:
#
#   /etc/inittab     starts the console's login and the agent. A copy on the
#                    disk without them, which an older image or an edit may
#                    have left there, would hide both: a terminal that never
#                    opens, and an app that never hears that Linux is up. Set
#                    aside rather than deleted, under a name no earlier copy
#                    has, and said so at the next login, since an edit of it
#                    stops working. A whiteout, which is what deleting the
#                    file leaves, is lifted. A copy that does start them but
#                    has lines from before Kernel Log, exactly as the image
#                    had them, has those brought up to date: the login on
#                    ttyS0, which lacked the TERM and size tctish-login gives
#                    it, and services on the console, which is ttyS0 now and
#                    whose settings init resets each time it starts one.
#
# And once per disk, so that someone who installs dropbear again on purpose
# keeps it:
#
#   apk's world      loses dropbear, if the disk has a copy of the file,
#                    so that the next apk run takes dropbear and the libraries
#                    it brought away, rather than putting them back.
#   authorized_keys  init used to copy the repo's placeholder key in on every
#                    boot. Its private half is public, so the key goes, and
#                    the file with it if nothing else is left in it.
#   host keys        the keys dropbear made for itself on first start.
#
# The stamp is left only if every step worked, so that a disk that was full,
# say, has them tried again.
USERROOT=/var/tcti-rootfs/rw-ios/userroot
INITTAB="$USERROOT/etc/inittab"
if [ -c "$INITTAB" ]; then
	rm -f "$INITTAB"
elif [ -f "$INITTAB" ] && ! { grep -q '^[^#]*tctish-login' "$INITTAB" &&
	grep -q '^[^#]*tctish-agent' "$INITTAB"; }; then
	ASIDE="$INITTAB.before-console"
	n=1
	while [ -e "$ASIDE" ]; do
		ASIDE="$INITTAB.before-console.$n"
		n=$((n + 1))
	done
	mv "$INITTAB" "$ASIDE"

	ASIDE="/etc/${ASIDE##*/}"
	echo "tctish: moved /etc/inittab to $ASIDE, as it would hide the console" >/dev/kmsg

	# Said once, at the next login, by a script that then removes itself.
	mkdir -p "$USERROOT/etc/profile.d"
	cat >"$USERROOT/etc/profile.d/tctish-inittab-notice.sh" <<-EOF
		echo "tctiSH: your /etc/inittab didn't start this terminal, so it is now $ASIDE."
		echo "Copy any changes you made to it into /etc/inittab."
		echo
		rm -f /etc/profile.d/tctish-inittab-notice.sh
	EOF
elif [ -f "$INITTAB" ] && grep -qxE 'ttyS0::respawn:/bin/busybox login -f root|::respawn:/usr/bin/tctish-(powerbtn|agent)|::respawn:/sbin/syslogd -n -S -s 12 -b 8' "$INITTAB"; then
	sed -i \
		-e 's|^ttyS0::respawn:/bin/busybox login -f root$|ttyS0::respawn:/usr/bin/tctish-login|' \
		-e 's|^::respawn:/usr/bin/tctish-powerbtn$|kmsg::respawn:/usr/bin/tctish-powerbtn|' \
		-e 's|^::respawn:/usr/bin/tctish-agent$|kmsg::respawn:/usr/bin/tctish-agent|' \
		-e 's|^::respawn:/sbin/syslogd -n -S -s 12 -b 8$|kmsg::respawn:/sbin/syslogd -n -S -s 12 -b 8|' \
		"$INITTAB"
	echo "tctish: brought /etc/inittab's lines from before Kernel Log up to date" >/dev/kmsg
fi

CONSOLE_STAMP=/var/tcti-rootfs/rw-ios/.tctish-ssh-removed
if [ ! -e "$CONSOLE_STAMP" ]; then
	MIGRATED=1
	if [ -f "$USERROOT/etc/apk/world" ]; then
		sed -i '/^dropbear$/d' "$USERROOT/etc/apk/world" || MIGRATED=
	fi

	KEYS="$USERROOT/root/.ssh/authorized_keys"
	PLACEHOLDER='ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQDeeHEUBy1ijDajh7rrxvNn94Z01kq0Ys[^ ]* ktemkin@aigis.ktemk.in'
	if [ -f "$KEYS" ] && grep -qx "$PLACEHOLDER" "$KEYS"; then
		sed -i "/^$PLACEHOLDER\$/d" "$KEYS" || MIGRATED=
		if [ ! -s "$KEYS" ]; then
			rm -f "$KEYS"
			rmdir "$USERROOT/root/.ssh" 2>/dev/null
		fi
	fi

	rm -f "$USERROOT"/etc/dropbear/dropbear_*_host_key || MIGRATED=
	rmdir "$USERROOT/etc/dropbear" 2>/dev/null

	[ -n "$MIGRATED" ] && touch "$CONSOLE_STAMP"
fi

# The image has /bin, /sbin and /lib merged into /usr: each is a link to its
# /usr counterpart. A disk that still has them as real directories (it predates
# the merge, or something has written to /bin since) would hide those links,
# and everything behind them, /bin/sh included. So the disk is merged the same
# way, with the same tool, before the overlay is mounted.
#
# merge-usr moves every entry across, whiteouts included, so files the disk
# deleted stay deleted. Where the disk had a file under both names, the /usr
# copy is kept and the other is set aside beside the root, as
# userrootbin.unmerged; that is moved onto the disk as /bin.unmerged, and the
# next login says so. If the merge fails, the directories are set aside whole,
# so that the image's links work.
#
# This and the clean-up below run outside the guest's root, where an absolute
# link on the disk would point into this initramfs, so they could move or
# delete the image's files. A disk whose /usr, or a directory in it, is a link
# is therefore not merged or cleaned; its directories are set aside as if the
# merge had failed.
USRLINKED=
for dir in usr usr/bin usr/sbin usr/lib; do
	[ -L "$USERROOT/$dir" ] && USRLINKED=1
done

UNMERGED=
for dir in bin sbin lib; do
	if [ -d "$USERROOT/$dir" ] && [ ! -L "$USERROOT/$dir" ]; then
		UNMERGED="$UNMERGED /$dir"
	fi
done
if [ -n "$UNMERGED" ]; then
	mkdir -p "$USERROOT/var/log"
	MERGELOG="$USERROOT/var/log/tctish-merge-usr.log"
	[ -n "$USRLINKED" ] && echo "not merged: the disk's /usr, or a directory in it, is a link" >"$MERGELOG"
	if [ -z "$USRLINKED" ] && /usr/bin/merge-usr --root "$USERROOT" >"$MERGELOG" 2>&1; then
		echo "tctish: merged the disk's$UNMERGED into /usr, as the image is" >/dev/kmsg
		NOTICE="merged$UNMERGED on your disk into /usr, as Alpine now has them"
	else
		echo "tctish: couldn't merge the disk's$UNMERGED into /usr; setting them aside" >/dev/kmsg
		NOTICE="couldn't merge$UNMERGED on your disk into /usr, so set them aside"
		for dir in $UNMERGED; do
			if [ -d "$USERROOT$dir" ] && [ ! -L "$USERROOT$dir" ]; then
				mv "$USERROOT$dir" "$USERROOT$dir.unmerged-failed"
			fi
		done
	fi

	ASIDE=
	for dir in bin sbin lib; do
		if [ -e "${USERROOT}$dir.unmerged" ]; then
			TO="/$dir.unmerged"
			n=1
			while [ -e "$USERROOT$TO" ]; do
				TO="/$dir.unmerged.$n"
				n=$((n + 1))
			done
			mv "${USERROOT}$dir.unmerged" "$USERROOT$TO"
			ASIDE="$ASIDE $TO"
		fi
	done
	[ -n "$ASIDE" ] && NOTICE="$NOTICE. Files that were there twice are in$ASIDE"

	# Said once, at the next login, by a script that then removes itself.
	mkdir -p "$USERROOT/etc/profile.d"
	cat >"$USERROOT/etc/profile.d/tctish-merge-notice.sh" <<-EOF
		echo "tctiSH: $NOTICE. The details are in /var/log/tctish-merge-usr.log."
		echo
		rm -f /etc/profile.d/tctish-merge-notice.sh
	EOF
fi

# tctiSH's guest tools talk to the app and must match it. A copy of one on the
# disk, left by an older image or installed by hand, hides the image's: a
# tctictl from 2022 that doesn't know what the app asks of it now, or a script
# that still drives the monitor over TCP. These names are tctiSH's, so every
# boot removes any copy from the disk, edited or not, and any whiteout, which
# hides the image's copy just as well, and logs each to the kernel log. Only
# /usr/bin is checked: the merge above has left /bin a link to it.
for tool in "$USERROOT"/usr/bin/tctictl "$USERROOT"/usr/bin/tctish-* "$USERROOT"/usr/bin/mount.ios; do
	[ -z "$USRLINKED" ] || break
	if [ -e "$tool" ] || [ -L "$tool" ]; then
		rm -f "$tool" &&
			echo "tctish: removed the disk's copy of ${tool#"$USERROOT"}, which hid tctiSH's" >/dev/kmsg
	fi
done


# ... and finally, mount together our union.
mkdir -p /var/tcti-rootfs/rw-ios/work
mkdir -p /var/tcti-rootfs/rw-ios/userroot
mount -t overlay overlay \
	-o lowerdir=/var/tcti-rootfs/ro-root,upperdir=/var/tcti-rootfs/rw-ios/userroot,workdir=/var/tcti-rootfs/rw-ios/work \
	/var/tcti-rootfs/rw-union

# Splork our procfs and sysfs into our new root.
mount -t proc		none /var/tcti-rootfs/rw-union/proc
mount -t sysfs		none /var/tcti-rootfs/rw-union/sys
mount -t devtmpfs	none /var/tcti-rootfs/rw-union/dev

# The pseudo-filesystems the 6.18 kernel's new capabilities are reached through.
# None of these costs anything at runtime -- they are virtual, with no threads,
# no timers and no I/O; mounting them only makes an interface visible. The work
# behind tracing and memory accounting is paid for by having the features
# compiled in at all, which already happened, and by actually using them.
#
#   tracefs     ftrace, kprobes, uprobes and the tracepoints BPF attaches to.
#               Without it /sys/kernel/tracing is an empty directory.
#   bpffs       where BPF maps and programs are pinned. libbpf and bpftool both
#               expect it at this path, and object pinning simply fails without.
#   cgroup2     required to attach any cgroup-scoped BPF program, and what makes
#               CONFIG_MEMCG reachable. Mounting alone enables no controllers;
#               that is a separate, explicit step via cgroup.subtree_control.
#   securityfs  where the LSM interface, including BPF LSM, appears.
#   debugfs     0700 because it exposes a great deal of kernel internals. Some
#               older tooling still reaches tracing through it rather than
#               through tracefs.
mount -t tracefs    none /var/tcti-rootfs/rw-union/sys/kernel/tracing
mount -t bpf        none /var/tcti-rootfs/rw-union/sys/fs/bpf
mount -t cgroup2    none /var/tcti-rootfs/rw-union/sys/fs/cgroup
mount -t securityfs none /var/tcti-rootfs/rw-union/sys/kernel/security
mount -t debugfs -o mode=700 none /var/tcti-rootfs/rw-union/sys/kernel/debug

# Ensure we can create psuedoterminals.
#
# -p because devtmpfs may already have provided it, which it does on a current
# kernel; without it the boot prints a spurious "File exists" every time.
mkdir -p /var/tcti-rootfs/rw-union/dev/pts
mount -t devpts none /var/tcti-rootfs/rw-union/dev/pts

# Always overcommit memory.
#
# The kernel's default (mode 0) refuses any single private mapping larger than
# RAM plus swap up front, however little of it would ever be touched. The guest
# has no swap and is often given only a gibibyte, so programs that reserve large
# ranges and use little of them fail at the reservation: Lean asks for a 1 GiB
# thread stack, gets ENOMEM, and reports "failed to create thread: Resource
# temporarily unavailable". A desktop with more memory than that never sees it.
#
# This cannot cost the phone anything. QEMU caps guest RAM at -m, and iOS only
# charges the app for guest pages actually touched; overcommit changes what
# Linux agrees to reserve, not what the guest can use. What it changes inside
# the guest is that running out is met by the OOM killer rather than by a failed
# allocation -- which the default mode does not prevent either, since it only
# catches a single oversized request, not many ordinary ones.
#
# Here rather than in /etc/sysctl.conf because nothing in this boot reads that:
# busybox init has no sysctl step. The setting is global, so the namespace this
# runs in does not matter.
echo 1 >/proc/sys/vm/overcommit_memory

# Emulation hack: replace our random and urandom devices with a direct call
# up to the _host_'s version of these files, since the host has more entropy.
rm \
	/var/tcti-rootfs/rw-union/dev/random  \
	/var/tcti-rootfs/rw-union/dev/urandom
make_misc_dev /var/tcti-rootfs/rw-union/dev/random hw_random
make_misc_dev /var/tcti-rootfs/rw-union/dev/urandom hw_random

# Emulation: try to mount /ios_host, if possible.
#mkdir /var/tcti-rootfs/rw-union/ios_host
#mount -t 9p -o trans=virtio shared /var/tcti-rootfs/rw-union/ios_host -oversion=9p2000.L

# Bring CPUs the host plugs in online; see tctish-cpu-online. Last before init
# proper, so that the boot's events are over and none of them forks it.
echo /usr/bin/tctish-cpu-online >/proc/sys/kernel/hotplug

# Finally, pass control to real init.
exec chroot /var/tcti-rootfs/rw-union /sbin/init
