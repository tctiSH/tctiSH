# tctiSH guest kernel configuration.
#
# This is the whole configuration, in `savedefconfig` form: a minimal list of
# everything that differs from the kernel's own defaults. Symbols absent from
# this file take whatever the kernel defaults them to, which is what makes 270
# lines enough to describe a kernel with thousands of options.
#
# It replaces the pair this used to be -- a 77 KB .config captured from the 2022
# build, plus a fragment merged over it. That split existed because the old
# config was the only record of which drivers this guest needs; once it had been
# carried forward to 6.18 and read through, keeping the 2022 artefact around
# bought nothing that this file does not say more clearly.
#
# **Every line here is asserted after configuration.** build_kernel.sh re-reads
# this file and checks the resolved .config agrees, and fails the build if one
# did not take. Kconfig's failure mode is silence: a symbol whose dependencies
# are unmet is dropped without a word, the kernel builds, boots, and simply does
# not have the feature. Two real faults were caught this way -- see the
# mitigations block, and note that squashfs below needs MISC_FILESYSTEMS,
# without which it silently vanishes.
#
# Keep prose out of the `# CONFIG_X is not set` shape. Kconfig reads any comment
# of exactly that form as a directive, so a sentence that happens to end that way
# would quietly turn a symbol off.
#
# To regenerate the carried-forward part after a deliberate change:
#
#     make kernel-config                 # resolve and report the delta
#     ./assets/build_kernel.sh --savedefconfig
#
# That writes a fresh minimal list to build-kernel/; fold it in by hand, because
# the prose here does not survive a round trip.
#
# See tmp/plans/kernel-upgrade.md.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
#
# LOCALVERSION is load-bearing, not cosmetic: assets/scripts/tctish-mount
# branches on `uname -r` containing "tctish" to choose between the in-guest and
# the on-host QMP address. Drop it and the script keeps running, against the
# wrong endpoint.
#
# LOCALVERSION_AUTO off for reproducibility -- it would append a git description
# of the source tree, and we build from a release tarball.
#
# DEFAULT_HOSTNAME is where the shell prompt's hostname comes from; /etc/hostname
# says "localhost" and nothing in the guest applies it.
CONFIG_LOCALVERSION="tctish"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="tctiSH"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CLOCKSOURCE_WATCHDOG_MAX_SKEW_US=100
# ---------------------------------------------------------------------------
# eBPF
# ---------------------------------------------------------------------------
#
# The 2022 config had CONFIG_BPF=y but no BPF_SYSCALL, which means bpf(2) did
# not exist: the core was present only because something else selected it.
#
# BPF_JIT_ALWAYS_ON is deliberately NOT set. The JIT emits x86_64 at runtime
# inside a guest that is itself being translated -- self-modifying code as far as
# TCG is concerned, and quite possibly slower than the interpreter here. Leaving
# ALWAYS_ON unset keeps `sysctl net.core.bpf_jit_enable=0` available so the
# question can be settled by measurement rather than assumption.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_BSD_PROCESS_ACCT=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
# CONFIG_CPU_ISOLATION is not set
CONFIG_LOG_BUF_SHIFT=18
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_DEBUG=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_SYSFS_SYSCALL=y
CONFIG_EXPERT=y
CONFIG_KALLSYMS_ALL=y
CONFIG_SMP=y
# CONFIG_X86_X2APIC is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_NR_CPUS=16
CONFIG_X86_REROUTE_FOR_BROKEN_BOOT_IRQS=y
# CONFIG_X86_MCE is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
# CONFIG_PERF_EVENTS_INTEL_CSTATE is not set
# CONFIG_PERF_EVENTS_AMD_UNCORE is not set
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
# CONFIG_MTRR_SANITIZER is not set
# CONFIG_X86_KERNEL_IBT is not set
# ---------------------------------------------------------------------------
# Tick rate
# ---------------------------------------------------------------------------
#
# 100 Hz, down from the 1000 Hz the 2022 config used.
#
# Every timer tick is emulated work. At 1000 Hz across four CPUs that is 4000
# interrupts a second of pure overhead before the guest does anything useful.
# The cost of 100 Hz is coarser scheduling granularity, which is not perceptible
# in a shell session.
#
# This pairs with NO_HZ_IDLE (asserted at the end of this file, since it is now
# a default): NO_HZ_IDLE is what makes an *idle* tctiSH cheap by suppressing the
# tick entirely, and HZ_100 is what makes a *busy* one cheaper.
CONFIG_HZ_100=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# ---------------------------------------------------------------------------
# CPU speculation mitigations
# ---------------------------------------------------------------------------
#
# Off, restoring a 2022 decision that an upstream rename silently reversed. The
# old config carried `# CONFIG_SPECULATION_MITIGATIONS is not set`; that symbol
# became CONFIG_CPU_MITIGATIONS in 6.10, so `olddefconfig` had no old value to
# carry, took the new default of y, and turned on some twenty MITIGATION_*
# symbols including page table isolation and retpolines.
#
# Right on the merits too. These defend against microarchitectural side
# channels; the guest CPU is a software translator with no branch predictor to
# poison and no speculative loads to observe. The cost is real and lands on the
# paths a shell hammers -- PTI flushes the TLB on every syscall. The host's own
# mitigations are unaffected.
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_SUSPEND is not set
# ---------------------------------------------------------------------------
# Power management we cannot use
# ---------------------------------------------------------------------------
#
# Frequency scaling is meaningless under emulation -- there is no frequency to
# scale. This also takes the ondemand/userspace governors and intel_pstate.
# CONFIG_CPU_FREQ is not set
# CONFIG_ISA_DMA_API is not set
CONFIG_IA32_EMULATION=y
# CONFIG_VIRTUALIZATION is not set
# CONFIG_SCHED_CLUSTER is not set
# CONFIG_SCHED_MC is not set
CONFIG_KPROBES=y
CONFIG_JUMP_LABEL=y
# CONFIG_BLOCK_LEGACY_AUTOLOAD is not set
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BINFMT_MISC=y
# CONFIG_COMPAT_BRK is not set
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_XFRM_USER=y
CONFIG_XDP_SOCKETS=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_ROUTE_VERBOSE=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IP_PNP_RARP=y
CONFIG_IP_MROUTE=y
CONFIG_IP_PIMSM_V1=y
CONFIG_IP_PIMSM_V2=y
CONFIG_SYN_COOKIES=y
# CONFIG_INET_DIAG is not set
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_MD5SIG=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_NETWORK_SECMARK=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_EMATCH=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_BPF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_RFKILL=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PCI_PRI=y
CONFIG_PCI_PASID=y
CONFIG_HOTPLUG_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEBUG_DEVRES=y
CONFIG_CONNECTOR=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_BLK=y
# CONFIG_INTEL_MEI is not set
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI_CONSTANTS=y
CONFIG_SCSI_SPI_ATTRS=y
CONFIG_SCSI_VIRTIO=y
CONFIG_NETDEVICES=y
CONFIG_TUN=y
CONFIG_VIRTIO_NET=y
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
CONFIG_INPUT_SPARSEKMAP=y
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SERIO_SERPORT is not set
CONFIG_SERIO_LIBPS2=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=32
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_MANY_PORTS=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_DETECT_IRQ=y
# CONFIG_SERIAL_8250_LPSS is not set
# CONFIG_SERIAL_8250_MID is not set
# CONFIG_SERIAL_8250_PERICOM is not set
CONFIG_VIRTIO_CONSOLE=y
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_VIA is not set
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NVRAM=y
CONFIG_PTP_1588_CLOCK=y
# CONFIG_HWMON is not set
# ---------------------------------------------------------------------------
# Graphics
# ---------------------------------------------------------------------------
#
# tctiSH is headless: inittab puts a getty on ttyS0 and the app
# connects over SSH. Turning DRM off takes DRM_I915 with it -- an Intel
# integrated graphics driver, one of the largest in the tree, which had been
# enabled in a QEMU guest -- along with virtio-gpu and AGP.
#
# This does not block the planned X work. An X server in the guest serving an
# iOS-side client speaks the X protocol over a socket and needs no kernel
# graphics support at all; only a direct framebuffer would, and that is what
# DRM_VIRTIO_GPU would be re-enabled for. One line and a rebuild.
#
# Kept deliberately: VT, the 8250 and virtio consoles, evdev and VIRTIO_INPUT.
# Those are what additional getties and future input support need, and none of
# them depends on DRM.
# CONFIG_DRM is not set
CONFIG_HIDRAW=y
CONFIG_HID_A4TECH=y
CONFIG_HID_BELKIN=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CYPRESS=y
CONFIG_HID_EZKEY=y
CONFIG_HID_GYRATION=y
CONFIG_HID_ITE=y
CONFIG_HID_KENSINGTON=y
CONFIG_HID_REDRAGON=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MONTEREY=y
CONFIG_HID_PANTHERLORD=y
CONFIG_PANTHERLORD_FF=y
CONFIG_HID_PETALYNX=y
CONFIG_HID_SUNPLUS=y
CONFIG_HID_TOPSEED=y
# CONFIG_USB_SUPPORT is not set
CONFIG_RTC_CLASS=y
# CONFIG_RTC_HCTOSYS is not set
CONFIG_DMADEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_NVMEM_SYSFS is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_AUTOFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_PROC_KCORE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_HUGETLBFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NFS_FS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y
CONFIG_9P_FS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_CODEPAGE_852=y
CONFIG_NLS_CODEPAGE_861=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_STACK_USAGE=y
CONFIG_SCHEDSTATS=y
CONFIG_FUNCTION_TRACER=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_DEBUG_BOOT_PARAMS=y
# CONFIG_X86_DEBUG_FPU is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

# ---------------------------------------------------------------------------
# Asserted, though currently redundant
# ---------------------------------------------------------------------------
#
# Everything below already matches the kernel's default, so `savedefconfig`
# drops it. It is stated explicitly anyway, because build_kernel.sh asserts
# every line in this file against the resolved .config -- which makes this
# section a tripwire rather than documentation.
#
# That is not hypothetical. The mitigations entry above is exactly this failure:
# a symbol renamed upstream, a setting silently discarded, a kernel that booted
# perfectly well and was wrong. A default that holds today is not a default that
# holds across the next four-year jump.

# ACPI. Enabling this is what fixed CPU enumeration: discovery moved from the
# Intel MP table (which enumerates per socket, so cores inside a socket were
# invisible) to the MADT. qemu_launcher.c used to spell the topology out as
# `-smp 4,sockets=4,cores=1,threads=1` to work around it and no longer does.
# ACPI_BUTTON receives QEMU's `system_powerdown`. Worth being precise about what
# that buys: the kernel now *gets* the event, where the 2022 kernel had no ACPI
# and could not. It does not act on it -- a power button event is delivered to
# userspace, and nothing in this guest listens yet. Making powerdown actually
# work needs a handler (busybox has an acpid applet), which is guest-image work
# rather than a kernel symbol.
CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_BUTTON=y

# Kept, against the instinct to trim them. A VM has no battery, mains adapter or
# thermal zone, so these drivers find no ACPI devices and do nothing -- the cost
# is a few KB of code and no probe time, because probing is driven by what is in
# the ACPI namespace. They are kept because host battery and thermal data is
# something we may want to surface to the guest later, and this is the built-in
# route for it.
#
# Worth recording the caveat: ACPI is a *hard* way to do that. It would mean
# QEMU synthesising battery and thermal devices in the DSDT, which is real work
# in QEMU's ACPI table generation. A tctictl verb or a virtio-serial channel
# would be far less machinery for the same result. Keeping these costs nothing,
# but it should not be mistaken for the feature being nearly done.
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y

# No fans and no backlight, and no plausible future use for either.
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_VIDEO is not set

# Microcode loading cannot be turned off, which is worth recording so nobody
# spends an afternoon on it again. CONFIG_MICROCODE is `def_bool y` in 6.18,
# depending only on CPU_SUP_AMD || CPU_SUP_INTEL -- there is no prompt and no way
# to say no short of claiming the kernel supports neither vendor's CPUs.
#
# Harmless in practice: with no microcode blob in the initrd and no QEMU path to
# deliver one, the code is inert. It is dead weight, not a running cost.

# The haltpoll driver spins before halting, betting that a wakeup is imminent.
# That is tuned for KVM guests wanting low latency; here it would burn host CPU
# to save nothing, which is precisely backwards for an app that should be cheap
# while idle.
#
# Disabled at the driver rather than the governor: CPU_IDLE_GOV_HALTPOLL is
# select-only, and HALTPOLL_CPUIDLE is what selects it. It is `default y` and
# depends on KVM_GUEST, so it arrives switched on without anyone choosing it.
# CONFIG_HALTPOLL_CPUIDLE is not set

# The TIOCSTI ioctl injects characters into a terminal's input queue. It is a
# well-known local privilege foot-gun and nothing in the guest uses it.
# CONFIG_LEGACY_TIOCSTI is not set

# I2C-attached HID, meaning laptop touchpads and touchscreens. There is no I2C
# bus in this machine for one to be attached to.
# CONFIG_I2C_HID is not set

# The idle tick suppression that makes an open-but-unused tctiSH cheap. See the
# HZ_100 note above; these two are complementary rather than alternatives.
CONFIG_NO_HZ_IDLE=y

# Boot-critical, and none of it changed. The overlay root, the host folder
# mounts, the app's disk, the initramfs the whole boot design rests on, and the
# console. Each would fail late and confusingly if a rename dropped it.
CONFIG_BINFMT_ELF=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
CONFIG_VT=y

# The pseudo-filesystems assets/overlay/init mounts. Compiled in here, mounted
# there; the guest's eBPF tooling needs both halves.

# Build hygiene. The toolchain is pinned by assets/kernel/flake.lock and is well
# ahead of what 6.18 was released against, so a warning nobody has fixed yet
# should not be a failed build. The kernel's own CI sets this.
# CONFIG_WERROR is not set
